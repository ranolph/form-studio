# Copy to .env to override defaults. No .env is needed for the basic quick start.
FORM_STUDIO_PORT=8785
BIND_ADDRESS=0.0.0.0

# Printer build volume in millimetres, in X,Y,Z order.
FORM_STUDIO_BED_SIZE=256,256,256

# Optional. Used only when a new data directory is initialised.
# After first start, set/change this address in the application's Settings.
# Use the server-reachable address, not localhost inside another container.
LAYER_LIBRARY_URL=

# The container runs without root. Bind-mounted data must be writable by these IDs.
# Changing them requires an image rebuild and existing data ownership adjustment.
APP_UID=1000
APP_GID=1000
